# Mastery Trainer conversation
dialogue.mmo_mastery_trainer.ready_generic.text = Di ritorno, e con qualcosa in mano. Posalo e diamo un'occhiata.
dialogue.mmo_mastery_trainer.menu.text = Le discipline sono qui quando le vuoi. Di cosa hai bisogno?
dialogue.mmo_mastery_trainer.menu.opt.quests = Che compiti hai per me?
dialogue.mmo_mastery_trainer.menu.opt.lessons = Hai delle lezioni per me?
dialogue.mmo_mastery_trainer.menu.opt.standing = Come me la cavo?
dialogue.mmo_mastery_trainer.menu.opt.mastery = Mostrami la mia maestria.
dialogue.mmo_mastery_trainer.menu.opt.farewell = Addio.
dialogue.mmo_mastery_trainer.lessons_fresh.text = Oggi la mia bacheca ha lezioni nuove. Ognuna si svolge là fuori, nel mondo.\nFinisci una e torna qui a riscuotere quello che paga.
dialogue.mmo_mastery_trainer.tithe_credit.text = Per un bel pezzo mi hai mandato una decima, e io ho tenuto il conto.\nOra insegno lezioni, e pago man mano che sali. Quello che hai già dato conta.
dialogue.mmo_mastery_trainer.tithe_credit.opt.collect = Quanto vale?
dialogue.mmo_mastery_trainer.first_words.text = Quindi la guida ti ha mandato quaggiù, dopotutto.\nUn'abilità non si ferma dove si fermano i suoi livelli. Ciò che viene dopo è ciò che insegno. Io la chiamo maestria.
dialogue.mmo_mastery_trainer.first_words.opt.hail = La guida ha parlato di te.
