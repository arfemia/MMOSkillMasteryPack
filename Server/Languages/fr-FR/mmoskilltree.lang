# Mastery Trainer conversation
dialogue.mmo_mastery_trainer.ready_generic.text = De retour, et avec quelque chose dans les mains. Pose-le, et voyons cela.
dialogue.mmo_mastery_trainer.menu.text = Les disciplines sont là quand tu les veux. De quoi as-tu besoin ?
dialogue.mmo_mastery_trainer.menu.opt.quests = Quelles tâches as-tu pour moi ?
dialogue.mmo_mastery_trainer.menu.opt.mastery = Montre-moi ma maîtrise.
dialogue.mmo_mastery_trainer.menu.opt.farewell = Adieu.
dialogue.mmo_mastery_trainer.first_words.text = Ainsi, le guide t'a fait descendre, après tout.\nUne compétence ne s'arrête pas là où s'arrêtent ses niveaux. Ce qui vient après, c'est ce que j'enseigne. J'appelle cela la maîtrise.
dialogue.mmo_mastery_trainer.first_words.opt.hail = Le guide a parlé de toi.
