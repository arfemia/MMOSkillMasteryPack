# Mastery Trainer conversation
dialogue.mmo_mastery_trainer.ready_generic.text = De vuelta, y con algo en las manos. Déjalo aquí y veámoslo.
dialogue.mmo_mastery_trainer.menu.text = Las disciplinas están aquí cuando las quieras. ¿Qué necesitas?
dialogue.mmo_mastery_trainer.menu.opt.quests = ¿Qué tareas tienes para mí?
dialogue.mmo_mastery_trainer.menu.opt.mastery = Muéstrame mi maestría.
dialogue.mmo_mastery_trainer.menu.opt.farewell = Adiós.
dialogue.mmo_mastery_trainer.first_words.text = Así que el guía te envió aquí abajo después de todo.\nUna habilidad no se detiene donde se acaban sus niveles. Lo que viene después es lo que enseño. Lo llamo maestría.
dialogue.mmo_mastery_trainer.first_words.opt.hail = El guía habló de ti.
