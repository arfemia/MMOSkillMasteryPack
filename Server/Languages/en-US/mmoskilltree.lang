# --- The lessons board (board.<id>.title / .desc, and its bands' badges) ---
board.mmo_mastery_lessons.title = The Trainer's Lessons
board.mmo_mastery_lessons.desc = Fresh lessons every morning, each one done out in the world. Collect what a lesson pays here at the board. The further you rise with me, the more lessons I post for you.
board.mmo_mastery_lessons.grade.gathering = Gathering
board.mmo_mastery_lessons.grade.fighting = Fighting
board.mmo_mastery_lessons.grade.crafting = Crafting
board.mmo_mastery_lessons.grade.hard = Hard
board.mmo_mastery_lessons.grade.master = Master's

