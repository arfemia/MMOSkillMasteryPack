# Mastery Trainer conversation
dialogue.mmo_mastery_trainer.ready_generic.text = Back, and carrying something. Set it down and let us see it.
dialogue.mmo_mastery_trainer.menu.text = The disciplines are here when you want them. What do you need?
dialogue.mmo_mastery_trainer.menu.opt.quests = What tasks do you have for me?
dialogue.mmo_mastery_trainer.menu.opt.mastery = Show me my mastery.
dialogue.mmo_mastery_trainer.menu.opt.farewell = Farewell.
dialogue.mmo_mastery_trainer.first_words.text = So the guide sent you down after all.\nA skill does not stop where its levels do. What comes after is what I teach. I call it mastery.
dialogue.mmo_mastery_trainer.first_words.opt.hail = The guide spoke of you.
