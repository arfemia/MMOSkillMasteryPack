# MMOSkillMasteryPack - títulos de missões + ambientação, nomes de moedas e outros textos de exibição.
# As chaves são simples; o I18nModule do Hytale prefixa o nome do arquivo, então cada uma carrega como
# mmoskilltree.<key> e o mod a resolve por convenção (quest.<id>.title / .flavor,
# currency.<id>.name, shop.<id>.title / .desc, ...). Adicione um <locale>/mmoskilltree.lang com
# as mesmas chaves para traduzir; chaves ausentes recorrem ao inglês por chave.

# --- Missões (quest.<id>.title / .flavor, resolvidas por convenção; segue o padrão das recompensas) ---
quest.meet_the_mastery_trainer.title = Uma palavra com o treinador
quest.meet_the_mastery_trainer.flavor = Tem mais alguém aqui embaixo que você deveria conhecer. Ensina maestria. Atravesse o patamar e dê um oi.
quest.mastery_tribute.title = O que se deve ao treinador
quest.mastery_tribute.flavor = Traga essência e alguns retalhos de linho, e abata algumas feras no caminho. Eu te dou algo que valha a caminhada. O quê, eu não saberia dizer.
quest.pack_first_milestone.title = O Primeiro Marco
quest.pack_first_milestone.flavor = Leve qualquer uma das suas habilidades até o primeiro marco e depois volte a mim. É aí que começa o meu ensino.
quest.pack_essence_collector.title = Coletor de Essência
quest.pack_essence_collector.flavor = Traga-me Essência da Vida. Eu a transformo em maestria, aos poucos.
quest.pack_essence_devotee.title = Devoto da Essência
quest.pack_essence_devotee.flavor = Você já me trouxe essência antes. Desta vez, traga-me um saco cheio.
quest.pack_path_of_mastery.title = Muitos Ofícios
quest.pack_path_of_mastery.flavor = Uma só habilidade boa não basta para o que eu ensino. Eleve várias delas bem alto e depois volte a mim.
quest.pack_mastery_tithe.title = Dízimo da Maestria
quest.pack_mastery_tithe.flavor = O códice da maestria cobra um dízimo de sangue e madeira. Abata algumas criaturas e corte algumas toras.
quest.mastery_tithe_credit.title = O Que Você Já Pagou
quest.mastery_tithe_credit.flavor = Eu contei cada dízimo que você me mandou. Venha me encontrar no Templo Esquecido, e vamos acertar quanto tudo isso vale agora.
quest.mastery_lesson_week.title = Uma Semana de Lições
quest.mastery_lesson_week.flavor = Cumpra minhas lições durante a semana e volte a mim quando tiver feito um punhado delas. Um dia ou dois perdidos não custam a sua semana.

# --- As lições do Treinador de Maestria (contratos do quadro; quest.<id>.title / .flavor) ---
quest.mmo_lesson_timber.title = Prática de Corte
quest.mmo_lesson_timber.flavor = Um golpe firme é a primeira coisa que ensino. Saia e derrube árvores até seus braços conhecerem o trabalho sem precisar perguntar.
quest.mmo_lesson_ore.title = Trabalho na Veia
quest.mmo_lesson_ore.flavor = Ache uma veia de minério e trabalhe nela até a rocha não dar mais nada. Um minerador que para na pedra fácil não aprende nada com ela.
quest.mmo_lesson_fishing.title = Vara e Linha
quest.mmo_lesson_fishing.flavor = Leve uma vara até a água e espere. Paciência também é uma disciplina, e a maioria de quem desce até aqui não tem nenhuma.
quest.mmo_lesson_hunt.title = Treino de Caça
quest.mmo_lesson_hunt.flavor = Saia além dos degraus do templo e abata o que vier contra você. Qualquer criatura serve, contanto que você volte com as próprias pernas.
quest.mmo_lesson_abilities.title = Treino de Habilidades
quest.mmo_lesson_abilities.flavor = Suas habilidades são aptidões como qualquer outra, e aptidões enferrujam. Use-as lá fora, no mundo, até virarem reflexo.
quest.mmo_lesson_crafting.title = Prática de Bancada
quest.mmo_lesson_crafting.flavor = Fabrique coisas. Qualquer coisa, na bancada que quiser. Mãos que só golpeiam e cavam esquecem como se constrói.
quest.mmo_lesson_workshop.title = Horas de Oficina
quest.mmo_lesson_workshop.flavor = Passe um bom tempo nas bancadas. Fabricar é uma aptidão como as outras, e quero vê-la crescer antes de você voltar.
quest.mmo_lesson_hard_timber.title = Corte Pesado
quest.mmo_lesson_hard_timber.flavor = Você já sabe manejar um machado. Desta vez, limpe um bosque inteiro e continue quando os ombros começarem a reclamar.
quest.mmo_lesson_hard_hunt.title = A Longa Caçada
quest.mmo_lesson_hard_hunt.flavor = Uma caçada mais longa desta vez. Fique lá fora até as criaturas pararem de vir, e depois fique mais um pouco.
quest.mmo_lesson_hard_study.title = Estudo Árduo
quest.mmo_lesson_hard_study.flavor = Treine a habilidade que quiser, mas treine com força. Eu vou saber pela sua cara se você treinou.
quest.mmo_lesson_master_ore.title = Veias Profundas
quest.mmo_lesson_master_ore.flavor = Desça até as veias mais fundas que alcançar e trabalhe nelas até secar. Um mestre não deixa minério bom na rocha.
quest.mmo_lesson_master_hunt.title = Caçada de Mestre
quest.mmo_lesson_master_hunt.flavor = Cace como um mestre caça, da primeira luz até a luz acabar. O que quer que esteja lá fora, abata e siga em frente.
quest.mmo_lesson_master_study.title = Estudo de Mestre
quest.mmo_lesson_master_study.flavor = Escolha uma habilidade qualquer e leve-a além do que você acha que ela vai. Uma lição de mestre deve te deixar cansado, e um pouco orgulhoso.

