          "Currencies": {
            "mastery_point": 6,
            "life_essence": 1500
          },
          "Items": [
            {
              "Item": "{dmgIngredient}",
              "Count": 2
            }
          ]
        },
        "Modifiers": [
          {
            "Shape": "FLAT",
            "ParamKey": "lifesteal",
            "Value": 3,
            "TargetSkill": "{skill}",
            "CombatTarget": "{skill}"
          }
        ]
      },
      "{prefix}_t2_cd": {
        "Tier": 2,
        "ChoiceGroup": "{prefix}_t2",
        "Prerequisites": [
          "{prefix}_t1_combo"
        ],
        "Requires": {
          "Factors": [
            {
              "Factor": "hytale:stat",
              "Param": "MMO_Level_{skill}",
              "Min": 40
            }
          ]
        },
        "Cost": {
          "Currencies": {
            "mastery_point": 6,
            "life_essence": 1500
          },
          "Items": [
            {
              "Item": "{comboIngredient}",
              "Count": 2
            }
          ]
        },
        "Modifiers": [
          {
            "Shape": "PERCENT",
            "ParamKey": "cooldownMs",
            "Value": -0.15,
            "TargetSkill": "{skill}"
          }
        ]
      },
      "{prefix}_t3_cap": {
        "Tier": 3,
        "Requires": {
          "Factors": [
            {
              "Factor": "hytale:stat",
              "Param": "MMO_Level_{skill}",
              "Min": 70
            }
          ],
          "AnyOf": [
            {
              "Factors": [
                {
                  "Factor": "mmoskilltree:mastery_node",
                  "Param": "{skillLower}_mastery:{prefix}_t2_life",
                  "Min": 1
                }
              ]
            },
            {
              "Factors": [
                {
                  "Factor": "mmoskilltree:mastery_node",
                  "Param": "{skillLower}_mastery:{prefix}_t2_cd",
                  "Min": 1
                }
              ]
            }
          ]
        },
        "Cost": {
          "Currencies": {
            "mastery_point": 12,
            "life_essence": 4000
          },
          "Items": [
            {
              "Item": "{dmgIngredient}",
              "Count": 3
            },
            {
              "Item": "Ingredient_Voidheart",
              "Count": 2
            }
          ]
        },
        "StatSacrifice": {
          "Stat": "{sacrificeStat}",
          "Mode": "permanent_max",
          "Amount": 10
        },
        "Modifiers": [
          {
            "Shape": "PERCENT",
            "ParamKey": "damage",
            "Value": 0.12,
            "TargetSkill": "{skill}",
            "CombatTarget": "{skill}"
          }
        ]
      },
      "{prefix}_eternal": {
        "Tier": 9,
        "Prerequisites": [
          "{prefix}_t3_cap"
        ],
        "Requires": {
          "Factors": [
            {
              "Factor": "hytale:stat",
              "Param": "MMO_Level_{skill}",
              "Min": 92
            }
          ]
        },
        "MaxPurchases": -1,
        "CostScaling": {
          "Curve": "EXPONENTIAL",
          "Multiplier": 1.1
        },
        "Cost": {
          "Currencies": {
            "mastery_point": 1,
            "life_essence": 350
          },
          "Items": [
            {
              "Item": "{dmgIngredient}",
              "Count": 2
            }
          ]
        },
        "Modifiers": [
          {
            "Shape": "PERCENT",
            "ParamKey": "damage",
            "Value": 0.005,
            "TargetSkill": "{skill}",
            "CombatTarget": "{skill}"
          }
        ]
      }
    }
  }
}
